{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pingta-guangpingwang/wgp-agent-bodification-flow/v0.4.0/spec/runtime-event.schema.json",
  "title": "WGP-ABF Runtime Event v0.4",
  "description": "One runtime event envelope. Storage, origin, and replay role are independent axes: a derived event may be durable, and a durable event is not necessarily a replay input.",
  "type": "object",
  "required": [
    "format",
    "eventId",
    "runId",
    "sequence",
    "occurredAt",
    "eventType",
    "storageClass",
    "origin",
    "replayRole",
    "producer",
    "subject",
    "payload",
    "redaction"
  ],
  "properties": {
    "format": { "const": "wgp-runtime-event/0.4" },
    "eventId": { "$ref": "#/$defs/uuid" },
    "runId": { "$ref": "#/$defs/id" },
    "sessionId": { "$ref": "#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 0 },
    "occurredAt": {
      "description": "Producer-reported occurrence time.",
      "type": "string",
      "format": "date-time"
    },
    "observedAt": {
      "description": "Optional collector observation time; use it to expose transport delay and clock skew.",
      "type": "string",
      "format": "date-time"
    },
    "eventType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
    },
    "storageClass": {
      "description": "Persistence policy only.",
      "enum": ["durable", "ephemeral"]
    },
    "origin": {
      "description": "Whether the event is a primary observation/input or a derived result.",
      "enum": ["primary", "derived"]
    },
    "replayRole": {
      "description": "How a replay engine may use the event; independent from persistence and derivation.",
      "enum": ["input", "expectedOutcome", "verificationOnly", "projectionOnly", "excluded"]
    },
    "producer": {
      "type": "object",
      "required": ["name", "version", "instanceId"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "instanceId": { "$ref": "#/$defs/id" },
        "artifactDigest": { "$ref": "#/$defs/contentHash" }
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["abirId"],
      "properties": {
        "abirId": { "$ref": "#/$defs/id" },
        "objectId": { "$ref": "#/$defs/id" },
        "portId": { "$ref": "#/$defs/id" },
        "recipeId": { "$ref": "#/$defs/id" },
        "recipeContentHash": { "$ref": "#/$defs/contentHash" }
      },
      "additionalProperties": false
    },
    "trace": {
      "type": "object",
      "required": ["traceId", "spanId"],
      "properties": {
        "traceId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "spanId": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
        "parentSpanId": { "type": "string", "pattern": "^[a-f0-9]{16}$" }
      },
      "additionalProperties": false
    },
    "payloadSchemaRef": { "type": "string", "format": "uri-reference" },
    "payload": {
      "description": "Event-type-owned JSON object; validate it with payloadSchemaRef when present.",
      "type": "object"
    },
    "derivation": { "$ref": "#/$defs/derivation" },
    "redaction": {
      "type": "object",
      "required": ["state", "removedFields"],
      "properties": {
        "state": { "enum": ["none", "redacted", "tokenized"] },
        "removedFields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "format": "json-pointer" }
        },
        "policyId": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": ["contentHash"],
      "properties": {
        "contentHash": { "$ref": "#/$defs/contentHash" },
        "previousEventHash": { "$ref": "#/$defs/contentHash" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "origin": { "const": "derived" } },
        "required": ["origin"]
      },
      "then": {
        "properties": { "derivation": { "$ref": "#/$defs/derivation" } },
        "required": ["derivation"]
      }
    },
    {
      "if": {
        "properties": { "origin": { "const": "primary" } },
        "required": ["origin"]
      },
      "then": { "not": { "required": ["derivation"] } }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "derivation": {
      "type": "object",
      "required": ["sourceEventIds", "algorithm", "version", "deterministic"],
      "properties": {
        "sourceEventIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uuid" }
        },
        "algorithm": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "deterministic": { "type": "boolean" },
        "algorithmDigest": { "$ref": "#/$defs/contentHash" }
      },
      "additionalProperties": false
    }
  }
}
