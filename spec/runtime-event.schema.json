{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pingta-guangpingwang/wgp-agent-bodification-flow/v0.6.0/spec/runtime-event.schema.json",
  "title": "WGP-ABF Runtime Event v0.6",
  "description": "One runtime event envelope. Storage, origin, and replay role are independent axes: a derived event may be durable, and a durable event is not necessarily a replay input.",
  "type": "object",
  "required": [
    "format",
    "eventId",
    "runId",
    "sequence",
    "occurredAt",
    "eventType",
    "storageClass",
    "origin",
    "replayRole",
    "producer",
    "subject",
    "payload",
    "redaction"
  ],
  "properties": {
    "format": { "const": "wgp-runtime-event/0.6" },
    "eventId": { "$ref": "#/$defs/uuid" },
    "runId": { "$ref": "#/$defs/id" },
    "sessionId": { "$ref": "#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 0 },
    "occurredAt": {
      "description": "Producer-reported occurrence time.",
      "type": "string",
      "format": "date-time"
    },
    "observedAt": {
      "description": "Optional collector observation time; use it to expose transport delay and clock skew.",
      "type": "string",
      "format": "date-time"
    },
    "eventType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
    },
    "storageClass": {
      "description": "Persistence policy only.",
      "enum": ["durable", "ephemeral"]
    },
    "origin": {
      "description": "Whether the event is a primary observation/input or a derived result.",
      "enum": ["primary", "derived"]
    },
    "replayRole": {
      "description": "How a replay engine may use the event; independent from persistence and derivation.",
      "enum": ["input", "expectedOutcome", "verificationOnly", "projectionOnly", "excluded"]
    },
    "producer": {
      "type": "object",
      "required": ["name", "version", "instanceId", "artifactRef"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "instanceId": { "$ref": "#/$defs/id" },
        "artifactRef": { "$ref": "#/$defs/exactArtifactRef" }
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["abirRef", "recipeRef"],
      "properties": {
        "abirRef": { "$ref": "#/$defs/exactDocumentRef" },
        "objectId": { "$ref": "#/$defs/id" },
        "portId": { "$ref": "#/$defs/id" },
        "recipeRef": { "$ref": "#/$defs/exactDocumentRef" },
        "standardPartBindingId": { "$ref": "#/$defs/id" },
        "partRef": { "$ref": "#/$defs/exactPartRef" },
        "packageRef": { "$ref": "#/$defs/exactDocumentRef" }
      },
      "dependentRequired": {
        "standardPartBindingId": ["partRef", "packageRef"],
        "partRef": ["standardPartBindingId", "packageRef"],
        "packageRef": ["standardPartBindingId", "partRef"]
      },
      "additionalProperties": false
    },
    "trace": {
      "type": "object",
      "required": ["traceId", "spanId"],
      "properties": {
        "traceId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "spanId": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
        "parentSpanId": { "type": "string", "pattern": "^[a-f0-9]{16}$" }
      },
      "additionalProperties": false
    },
    "payload": {
      "description": "Event-type-owned JSON object. Contract exchange payload identities are pinned independently for the producer and consumer endpoints.",
      "type": "object"
    },
    "contractExchange": {
      "description": "End-to-end producer-to-consumer evidence for one exact contract message. Producer and consumer observation times are evidence from their own clocks; ordering is established only inside orderingDomain by orderingSequence, never by comparing unrelated occurredAt values.",
      "$ref": "#/$defs/contractExchange"
    },
    "derivation": { "$ref": "#/$defs/derivation" },
    "redaction": {
      "type": "object",
      "required": ["state", "removedFields"],
      "properties": {
        "state": { "enum": ["none", "redacted", "tokenized"] },
        "removedFields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "format": "json-pointer" }
        },
        "policyId": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": ["contentHash"],
      "properties": {
        "contentHash": { "$ref": "#/$defs/contentHash" },
        "previousEventHash": { "$ref": "#/$defs/contentHash" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "origin": { "const": "derived" } },
        "required": ["origin"]
      },
      "then": {
        "properties": { "derivation": { "$ref": "#/$defs/derivation" } },
        "required": ["derivation"]
      }
    },
    {
      "if": {
        "properties": { "origin": { "const": "primary" } },
        "required": ["origin"]
      },
      "then": { "not": { "required": ["derivation"] } }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "exactPartRef": {
      "type": "object",
      "required": ["partId", "version", "contentHash"],
      "properties": {
        "partId": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "contentHash": { "$ref": "#/$defs/contentHash" }
      },
      "additionalProperties": false
    },
    "exactDocumentRef": {
      "type": "object",
      "required": ["id", "version", "contentHash"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "contentHash": { "$ref": "#/$defs/contentHash" }
      },
      "additionalProperties": false
    },
    "exactContractRef": {
      "type": "object",
      "required": ["contractId", "version", "contentHash"],
      "properties": {
        "contractId": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "contentHash": { "$ref": "#/$defs/contentHash" }
      },
      "additionalProperties": false
    },
    "exactArtifactRef": {
      "type": "object",
      "required": ["artifactId", "version", "contentHash"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "contentHash": { "$ref": "#/$defs/contentHash" }
      },
      "additionalProperties": false
    },
    "payloadSchemaIdentity": {
      "type": "object",
      "required": ["schemaRef", "schemaContentHash", "schemaBundleRef"],
      "properties": {
        "schemaRef": { "type": "string", "format": "uri-reference" },
        "schemaContentHash": {
          "description": "SHA-256 of the RFC 8785 canonical UTF-8 JSON serialization of the complete Schema document; this must equal the Contract structure identity.",
          "$ref": "#/$defs/contentHash"
        },
        "schemaBundleRef": { "$ref": "#/$defs/exactDocumentRef" }
      },
      "additionalProperties": false
    },
    "exchangeParty": {
      "type": "object",
      "required": [
        "partRef",
        "packageRef",
        "roleId",
        "observedAt",
        "contractRef",
        "channelId",
        "structureId",
        "payloadSchema",
        "payloadArtifactRef",
        "payloadDigest"
      ],
      "properties": {
        "partRef": { "$ref": "#/$defs/exactPartRef" },
        "packageRef": { "$ref": "#/$defs/exactDocumentRef" },
        "roleId": { "$ref": "#/$defs/id" },
        "observedAt": { "type": "string", "format": "date-time" },
        "contractRef": { "$ref": "#/$defs/exactContractRef" },
        "channelId": { "$ref": "#/$defs/id" },
        "structureId": { "$ref": "#/$defs/id" },
        "payloadSchema": { "$ref": "#/$defs/payloadSchemaIdentity" },
        "payloadArtifactRef": { "$ref": "#/$defs/exactArtifactRef" },
        "payloadDigest": {
          "description": "SHA-256 of the serialized payload bytes at this endpoint, after applying payloadEncoding and before transport framing.",
          "$ref": "#/$defs/contentHash"
        }
      },
      "additionalProperties": false
    },
    "exchangeResolution": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["exact", "compatible", "adapter"] },
        "compatibilityAssessmentRef": { "$ref": "#/$defs/exactDocumentRef" },
        "adapterArtifactRef": { "$ref": "#/$defs/exactArtifactRef" },
        "migrationPlanRef": { "$ref": "#/$defs/exactDocumentRef" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "exact" } },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "compatibilityAssessmentRef": false,
              "adapterArtifactRef": false,
              "migrationPlanRef": false
            }
          }
        },
        {
          "if": {
            "properties": { "mode": { "const": "compatible" } },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "compatibilityAssessmentRef": { "$ref": "#/$defs/exactDocumentRef" },
              "adapterArtifactRef": false,
              "migrationPlanRef": false
            },
            "required": ["compatibilityAssessmentRef"]
          }
        },
        {
          "if": {
            "properties": { "mode": { "const": "adapter" } },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "compatibilityAssessmentRef": { "$ref": "#/$defs/exactDocumentRef" },
              "adapterArtifactRef": { "$ref": "#/$defs/exactArtifactRef" },
              "migrationPlanRef": { "$ref": "#/$defs/exactDocumentRef" }
            },
            "required": ["compatibilityAssessmentRef", "adapterArtifactRef", "migrationPlanRef"]
          }
        }
      ],
      "additionalProperties": false
    },
    "streamPosition": {
      "type": "object",
      "required": ["streamId", "phase"],
      "properties": {
        "streamId": { "$ref": "#/$defs/id" },
        "phase": { "enum": ["open", "item", "complete", "error", "cancel"] },
        "itemSequence": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "phase": { "const": "item" } },
            "required": ["phase"]
          },
          "then": {
            "properties": {
              "itemSequence": { "type": "integer", "minimum": 0 }
            },
            "required": ["itemSequence"]
          }
        },
        {
          "if": {
            "properties": { "phase": { "enum": ["open", "complete", "error", "cancel"] } },
            "required": ["phase"]
          },
          "then": { "not": { "required": ["itemSequence"] } }
        }
      ],
      "additionalProperties": false
    },
    "contractExchange": {
      "type": "object",
      "required": [
        "contractBindingId",
        "messageId",
        "correlationId",
        "attempt",
        "producer",
        "consumer",
        "resolution",
        "outcome"
      ],
      "properties": {
        "contractBindingId": { "$ref": "#/$defs/id" },
        "messageId": { "$ref": "#/$defs/id" },
        "correlationId": { "$ref": "#/$defs/id" },
        "causationMessageId": { "$ref": "#/$defs/id" },
        "attempt": { "type": "integer", "minimum": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "orderingDomain": { "$ref": "#/$defs/id" },
        "orderingSequence": { "type": "integer", "minimum": 0 },
        "producer": { "$ref": "#/$defs/exchangeParty" },
        "consumer": { "$ref": "#/$defs/exchangeParty" },
        "resolution": { "$ref": "#/$defs/exchangeResolution" },
        "outcome": { "enum": ["accepted", "rejected", "cancelled", "failed"] },
        "stream": { "$ref": "#/$defs/streamPosition" }
      },
      "additionalProperties": false
    },
    "derivation": {
      "type": "object",
      "required": ["sourceEventIds", "algorithm", "version", "deterministic", "algorithmArtifactRef"],
      "properties": {
        "sourceEventIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uuid" }
        },
        "algorithm": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "deterministic": { "type": "boolean" },
        "algorithmArtifactRef": { "$ref": "#/$defs/exactArtifactRef" }
      },
      "additionalProperties": false
    }
  }
}
