{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pingta-guangpingwang/wgp-agent-bodification-flow/v0.4.0/spec/assembly-recipe.schema.json",
  "title": "WGP-ABF Assembly Recipe v0.4",
  "description": "A versioned, hash-addressed selection of implementations, bindings, placements, and runtime settings for one WGP-ABIR document.",
  "type": "object",
  "required": [
    "format",
    "id",
    "name",
    "version",
    "contentHash",
    "createdAt",
    "abir",
    "componentBindings",
    "resourceBindings",
    "policyBindings",
    "containerPlacements",
    "interfaceBindings",
    "runtime",
    "verification"
  ],
  "properties": {
    "format": { "const": "wgp-assembly-recipe/0.4" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "$ref": "#/$defs/localizedText" },
    "version": { "$ref": "#/$defs/semver" },
    "contentHash": { "$ref": "#/$defs/contentHash" },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "abir": {
      "type": "object",
      "required": ["id", "version", "contentHash"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "contentHash": { "$ref": "#/$defs/contentHash" }
      },
      "additionalProperties": false
    },
    "componentBindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/componentBinding" }
    },
    "resourceBindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/resourceBinding" }
    },
    "policyBindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/policyBinding" }
    },
    "containerPlacements": {
      "type": "array",
      "items": { "$ref": "#/$defs/containerPlacement" }
    },
    "interfaceBindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/interfaceBinding" }
    },
    "runtime": { "$ref": "#/$defs/runtime" },
    "verification": {
      "type": "array",
      "items": { "$ref": "#/$defs/verificationCheck" }
    },
    "metadata": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$" },
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "null" }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "zh-CN": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "configObject": {
      "description": "Implementation-owned JSON configuration. Validation is delegated to the referenced component or provider schema.",
      "type": "object"
    },
    "componentBinding": {
      "type": "object",
      "required": ["componentId", "implementationArtifactId", "enabled", "config"],
      "properties": {
        "componentId": { "$ref": "#/$defs/id" },
        "implementationArtifactId": { "$ref": "#/$defs/id" },
        "enabled": { "type": "boolean" },
        "config": { "$ref": "#/$defs/configObject" },
        "configSchemaRef": { "type": "string", "format": "uri-reference" }
      },
      "additionalProperties": false
    },
    "resourceBinding": {
      "type": "object",
      "required": ["resourceId", "provider", "settings", "credentialRefs"],
      "properties": {
        "resourceId": { "$ref": "#/$defs/id" },
        "provider": { "type": "string", "minLength": 1 },
        "artifactId": { "$ref": "#/$defs/id" },
        "endpoint": { "type": "string", "format": "uri" },
        "settings": { "$ref": "#/$defs/configObject" },
        "credentialRefs": {
          "description": "Names or opaque identifiers only; recipes must not embed credential values.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      },
      "additionalProperties": false
    },
    "policyBinding": {
      "type": "object",
      "required": ["policyId", "enforcedBy", "mode"],
      "properties": {
        "policyId": { "$ref": "#/$defs/id" },
        "enforcedBy": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "mode": { "enum": ["enforce", "audit", "disabled"] }
      },
      "additionalProperties": false
    },
    "containerPlacement": {
      "type": "object",
      "required": ["containerId", "objectIds"],
      "properties": {
        "containerId": { "$ref": "#/$defs/id" },
        "objectIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": { "type": "number", "exclusiveMinimum": 0 },
            "memoryMiB": { "type": "integer", "minimum": 1 },
            "timeoutMs": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "interfaceBinding": {
      "type": "object",
      "required": ["interfaceId", "enabled", "settings"],
      "properties": {
        "interfaceId": { "$ref": "#/$defs/id" },
        "enabled": { "type": "boolean" },
        "settings": { "$ref": "#/$defs/configObject" }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["engine", "entryComponentId", "environment", "startup", "restartPolicy"],
      "properties": {
        "engine": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "artifactId": { "$ref": "#/$defs/id" }
          },
          "additionalProperties": false
        },
        "entryComponentId": { "$ref": "#/$defs/id" },
        "environment": {
          "type": "object",
          "required": ["requiredVariables", "optionalVariables"],
          "properties": {
            "requiredVariables": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }
            },
            "optionalVariables": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }
            }
          },
          "additionalProperties": false
        },
        "startup": {
          "type": "object",
          "required": ["command", "arguments"],
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "arguments": {
              "type": "array",
              "items": { "type": "string" }
            },
            "workingDirectory": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "restartPolicy": { "enum": ["never", "onFailure", "always", "manual"] }
      },
      "additionalProperties": false
    },
    "verificationCheck": {
      "type": "object",
      "required": ["id", "kind", "required"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["schema", "health", "smoke", "policy", "snapshot", "custom"] },
        "required": { "type": "boolean" },
        "command": { "type": "string", "minLength": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "expected": { "$ref": "#/$defs/configObject" }
      },
      "additionalProperties": false
    }
  }
}
