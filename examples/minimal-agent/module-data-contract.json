        "protocolId": "wgp.message",
        "protocolVersion": "v1",
        "framingMediaType": "application/json",
        "framingEncoding": "utf-8"
      },
      "reliability": {
        "timeout": {
          "durationMs": 30000,
          "startsAt": "accepted",
          "onTimeout": "retry"
        },
        "retry": {
          "maxAttempts": 3,
          "strategy": "exponential",
          "initialDelayMs": 100,
          "maxDelayMs": 2000,
          "jitter": true,
          "retryOn": [
            "timeout",
            "transportError"
          ]
        },
        "idempotency": {
          "mode": "required",
          "keyPointer": "/messageId",
          "scope": "channel",
          "retentionMs": 86400000,
          "duplicatePolicy": "returnPrevious"
        },
        "delivery": "atMostOnce",
        "cancellation": {
          "supported": true,
          "propagation": "downstream",
          "terminal": true,
          "acknowledgementTimeoutMs": 5000
        },
        "errorHandling": {
          "classificationField": "/classification",
          "retryableField": "/retryable",
          "terminalField": "/terminal",
          "unknownError": {
            "classification": "unknown",
            "retryable": false,
            "terminal": true
          }
        }
      },
      "message": {
        "payloadStructureId": "structure.chat-message",
        "errorStructureId": "structure.exchange-error",
        "ordering": {
          "mode": "none",
          "gapPolicy": "fail"
        }
      },
      "connectionCardinality": "one"
    },
