  "identity": {
    "contractId": "contract.minimal-agent-boundaries",
    "name": {
      "zh-CN": "最小智能体模块数据契约",
      "en": "Minimal Agent Module Data Contract"
    },
    "description": {
      "zh-CN": "对齐对话、模型、事件与状态模块边界的数据结构和交换语义，不约束模块内部实现。",
      "en": "Aligns data structures and exchange semantics for chat, model, event, and state module boundaries without constraining internal implementations."
    },
    "version": "1.0.0",
    "status": "stable",
    "publisher": {
      "publisherId": "publisher.wgp-abf",
      "name": {
        "zh-CN": "WGP-ABF 参考实现",
        "en": "WGP-ABF Reference Implementation"
      },
      "url": "https://github.com/pingta-guangpingwang/wgp-agent-bodification-flow"
    }
  },
  "roles": [
    {
      "roleId": "role.chat-client-output",
      "kind": "producer",
      "name": {
        "zh-CN": "对话客户端输出",
        "en": "Chat client output"
      },
      "responsibility": {
        "zh-CN": "产生规范化用户消息。",
        "en": "Produce normalized user messages."
      }
    },
    {
      "roleId": "role.orchestrator-chat-input",
      "kind": "consumer",
      "name": {
        "zh-CN": "编排器对话输入",
        "en": "Orchestrator chat input"
      },
      "responsibility": {
        "zh-CN": "接收并验证用户消息。",
        "en": "Accept and validate user messages."
      }
    },
    {
      "roleId": "role.orchestrator-chat-output",
      "kind": "producer",
      "name": {
        "zh-CN": "编排器对话输出",
        "en": "Orchestrator chat output"
      },
      "responsibility": {
        "zh-CN": "产生有序助手数据块。",
        "en": "Produce ordered assistant chunks."
      }
    },
    {
      "roleId": "role.chat-client-input",
      "kind": "consumer",
      "name": {
        "zh-CN": "对话客户端输入",
        "en": "Chat client input"
      },
      "responsibility": {
        "zh-CN": "消费助手流直至结束或错误。",
        "en": "Consume the assistant stream through end or error."
      }
    },
    {
      "roleId": "role.orchestrator-model-output",
      "kind": "producer",
      "name": {
        "zh-CN": "编排器模型输出",
        "en": "Orchestrator model output"
      },
      "responsibility": {
        "zh-CN": "产生固定结构的模型请求。",
        "en": "Produce schema-pinned model requests."
      }
    },
    {
      "roleId": "role.model-provider-input",
      "kind": "consumer",
      "name": {
        "zh-CN": "模型提供方输入",
        "en": "Model provider input"
      },
      "responsibility": {
        "zh-CN": "消费模型请求。",
        "en": "Consume model requests."
      }
    },
    {
      "roleId": "role.model-provider-output",
      "kind": "producer",
      "name": {
        "zh-CN": "模型提供方输出",
        "en": "Model provider output"
      },
      "responsibility": {
        "zh-CN": "产生模型响应。",
        "en": "Produce model responses."
      }
    },
    {
      "roleId": "role.orchestrator-model-input",
      "kind": "consumer",
      "name": {
        "zh-CN": "编排器模型输入",
        "en": "Orchestrator model input"
      },
      "responsibility": {
        "zh-CN": "消费并验证模型响应。",
        "en": "Consume and validate model responses."
      }
    },
    {
      "roleId": "role.orchestrator-event-output",
      "kind": "producer",
      "name": {
        "zh-CN": "编排器事件输出",
        "en": "Orchestrator event output"
      },
      "responsibility": {
        "zh-CN": "产生可去重的生命周期事件。",
        "en": "Produce deduplicable lifecycle events."
      }
    },
    {
      "roleId": "role.observer-event-input",
      "kind": "consumer",
      "name": {
        "zh-CN": "观察器事件输入",
        "en": "Observer event input"
      },
      "responsibility": {
        "zh-CN": "按生产者顺序消费事件。",
        "en": "Consume events in producer order."
      }
    },
    {
      "roleId": "role.orchestrator-state-output",
      "kind": "producer",
      "name": {
        "zh-CN": "编排器状态输出",
        "en": "Orchestrator state output"
      },
      "responsibility": {
        "zh-CN": "产生版本化状态快照与增量。",
        "en": "Produce versioned state snapshots and deltas."
      }
    },
    {
      "roleId": "role.state-store-input",
      "kind": "consumer",
      "name": {
        "zh-CN": "状态存储输入",
        "en": "State store input"
      },
      "responsibility": {
        "zh-CN": "强一致地应用状态更新。",
        "en": "Apply state updates with strong consistency."
      }
    }
  ],
