{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pingta-guangpingwang/wgp-agent-bodification-flow/v0.6.0/examples/minimal-agent/schemas/wgp-lifecycle-event-v1.schema.json",
  "title": "Minimal lifecycle event v1",
  "type": "object",
  "required": ["eventId", "sequence", "occurredAt"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 0, "x-wgp-unit": { "system": "custom", "code": "event" } },
    "occurredAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
