{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pingta-guangpingwang/wgp-agent-bodification-flow/v0.6.0/examples/minimal-agent/schemas/wgp-state-delta-v1.schema.json",
  "title": "Minimal state delta v1",
  "type": "object",
  "required": ["stateVersion", "operation"],
  "properties": {
    "stateVersion": { "type": "integer", "minimum": 0 },
    "operation": { "enum": ["set", "delete"] },
    "value": { "type": ["object", "array", "string", "number", "boolean", "null"], "default": null }
  },
  "additionalProperties": false
}
