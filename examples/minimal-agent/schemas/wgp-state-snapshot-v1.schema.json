{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pingta-guangpingwang/wgp-agent-bodification-flow/v0.6.0/examples/minimal-agent/schemas/wgp-state-snapshot-v1.schema.json",
  "title": "Minimal state snapshot v1",
  "type": "object",
  "required": ["stateVersion", "sessionId"],
  "properties": {
    "stateVersion": { "type": "integer", "minimum": 0 },
    "sessionId": { "type": "string", "minLength": 1 }
