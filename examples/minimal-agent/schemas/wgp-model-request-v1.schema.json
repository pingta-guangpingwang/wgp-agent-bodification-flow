{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pingta-guangpingwang/wgp-agent-bodification-flow/v0.6.0/examples/minimal-agent/schemas/wgp-model-request-v1.schema.json",
  "title": "Minimal model request v1",
  "type": "object",
  "required": ["requestId", "model", "messages"],
  "properties": {
    "requestId": { "type": "string", "format": "uuid" },
    "model": { "type": "string", "minLength": 1 },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://raw.githubusercontent.com/pingta-guangpingwang/wgp-agent-bodification-flow/v0.6.0/examples/minimal-agent/schemas/wgp-chat-message-v1.schema.json" }
    },
    "maxTokens": { "type": "integer", "minimum": 1, "default": 2048, "x-wgp-unit": { "system": "custom", "code": "token" } }
  },
  "additionalProperties": false
}
